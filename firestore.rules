rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user identity matches path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate UserProfile document fields and reasonable size bounds
    function isValidUserProfile(data, userId) {
      return (!('uid' in data) || data.uid == userId)
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('targetBand' in data) || (data.targetBand is number && data.targetBand >= 0 && data.targetBand <= 9.0))
        && (!('streakDays' in data) || (data.streakDays is number && data.streakDays >= 0));
    }

    // Validate MistakeVaultItem document fields
    function isValidMistake(data, userId) {
      return (!('userId' in data) || data.userId == userId)
        && (!('item' in data) || (data.item is string && data.item.size() <= 2000))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000));
    }

    // Validate TestSubmission document fields
    function isValidSubmission(data, userId) {
      return (!('userId' in data) || data.userId == userId)
        && (!('bandScore' in data) || (data.bandScore is number && data.bandScore >= 0 && data.bandScore <= 9.0));
    }

    // Validate ChatSession document fields
    function isValidChat(data, userId) {
      return (!('userId' in data) || data.userId == userId)
        && (!('userMessage' in data) || (data.userMessage is string && data.userMessage.size() <= 4000))
        && (!('aiReply' in data) || (data.aiReply is string && data.aiReply.size() <= 8000));
    }

    // Candidate user profile and subcollections
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      // Candidate's private mistake vault
      match /mistakes/{mistakeId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMistake(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // Candidate's test and practice submissions
      match /submissions/{submissionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSubmission(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      // Candidate's multi-turn AI chat and live voice transcripts
      match /chats/{chatId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidChat(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
