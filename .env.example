# BandSprint — copy this file to .env and fill in your own keys.
# NEVER share your .env file. Never put real keys in chat.
# Get a free Gemini key: https://aistudio.google.com/app/apikey

# Google Gemini API Key for AI-powered IELTS evaluation & live tutor
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini models (safe defaults, free tier). Do not use gemini-2.5-* — shut down 1 Dec 2026.
# Main chat / evaluation: gemini-3.5-flash-lite (verified working on the free tier, 2026-11-19)
# Fast / cheap generation: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
GENERATOR_MODEL=gemini-3.5-flash-lite
SOLVER_MODEL=gemini-3.5-flash-lite

# Google Workspace / OAuth credentials (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloud Run deployment (set these as env vars on the Cloud Run service, not here)
# The live site that may call this server (CORS). Must match the Netlify URL exactly.
ALLOWED_ORIGINS=https://band-sprint.netlify.app
APP_URL=https://band-sprint.netlify.app
NODE_ENV=production

# Stripe Billing credentials (optional — only if you sell premium plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Avatar / speaking examiner APIs (optional — app works without them)
D_ID_API_KEY=
DID_API_KEY=
HEYGEN_API_KEY=
SIMLI_API_KEY=
